# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Environments
.venv/
venv/
env/

# Secrets - never commit real credentials
.env
.env.*
!.env.example

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Runtime artefacts
.cache/
parsed/
*.log

# Candidate documents. Resumes are personal data; keep them out of version control.
*.pdf
*.docx
!tests/fixtures/**/*.pdf
!tests/fixtures/**/*.docx

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
