# ---------------------------------------------------------------------------
# Provider credentials. Set at least one; the model chain in configs/default.yaml
# is filtered down to the providers that actually have a key.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...
# Point the OpenAI-compatible provider at a local runtime (Ollama, vLLM, LM Studio):
# RESUME_PARSER_OPENAI_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
RESUME_PARSER_ENVIRONMENT=development

# Shared secret for the API's x-api-key header. Leave unset to run the API open,
# which is fine locally and a mistake in production.
# RESUME_PARSER_API_KEY=change-me

# Optional YAML layer. Environment variables always win over it.
# RESUME_PARSER_CONFIG_FILE=configs/default.yaml

# ---------------------------------------------------------------------------
# Overrides. Nested keys use a double underscore: llm.effort -> LLM__EFFORT
# ---------------------------------------------------------------------------
# RESUME_PARSER_LLM__EFFORT=medium
# RESUME_PARSER_LLM__MAX_OUTPUT_TOKENS=16000
# RESUME_PARSER_LLM__TIMEOUT_SECONDS=120
# RESUME_PARSER_EXTRACTION__MAX_FILE_SIZE=16777216
# RESUME_PARSER_SERVER__HOST=127.0.0.1
# RESUME_PARSER_SERVER__PORT=8000
# RESUME_PARSER_SERVER__RATE_LIMIT_PER_MINUTE=60
# RESUME_PARSER_SERVER__CORS_ORIGINS=["https://app.example.com"]
# RESUME_PARSER_CACHE__DIRECTORY=.cache/parses
# RESUME_PARSER_OBSERVABILITY__JSON_LOGS=true
# RESUME_PARSER_OBSERVABILITY__LOG_LEVEL=INFO
